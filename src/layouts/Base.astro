---
// The site's layout: the kit's Base with the site's own footer. The slots are
// written without whitespace between them, so none leaks into <main>.
import KitBase from '@ninjainfosys/site-kit/layouts/Base.astro';
import Footer from '../components/site/Footer.astro';

const props = Astro.props;
---
<KitBase {...props}><slot name="head" slot="head" /><slot /><Footer slot="footer" /></KitBase>
