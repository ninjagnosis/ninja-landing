---
import { href, langOf, ui } from '../../lib/i18n';
export interface Props { heading?: string }
const lang = langOf(Astro.currentLocale);
const T = ui[lang];
const { heading = T.ctaHeading } = Astro.props;
---
<section class="cta on-stage">
  <div class="wrap inner">
    <h2>{heading}</h2>
    <div class="actions">
      <a class="btn btn-light" href={href(lang, '/contact')}>{T.contactUs}</a>
      <a class="btn btn-secondary" href="/blog">{T.readBlog}</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--space-9); }
  h2 { color: var(--stage-ink); max-width: 18ch; }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  .actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
</style>
