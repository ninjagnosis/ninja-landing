---
export interface Props { heading?: string }
const { heading = 'Get in touch' } = Astro.props;
---
<section class="cta on-stage">
  <div class="wrap inner">
    <h2>{heading}</h2>
    <div class="actions">
      <a class="btn btn-light" href="/contact">Contact us</a>
      <a class="btn btn-secondary" href="/blog">Read the blog</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--space-9); }
  h2 { color: var(--stage-ink); max-width: 18ch; }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  .actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
</style>
