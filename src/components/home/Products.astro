---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { products } from '../../data/products';
import { href, langOf, ui } from '../../lib/i18n';
export interface Props { heading?: string }
const lang = langOf(Astro.currentLocale);
const { heading = ui[lang].productsH } = Astro.props;
---
<section class="section" data-reveal>
  <div class="wrap">
    <h2>{heading}</h2>
    <ul class="list" data-stagger>
      {products.map((p, i) => (
        <li style={`--i:${i}`}>
          <a href={href(lang, `/products/${p.slug}`)}>
            <span class="name">{p.name}</span>
            <span class="short muted">{lang === 'ne' ? p.ne.short : p.short}</span>
            <ArrowRight class="go" size={20} stroke-width={2} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) auto; align-items: center; gap: var(--space-5); padding: var(--space-5) 0; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .name { font-family: var(--font-display); font-size: 1.375rem; font-weight: 600; transition: color var(--fast) var(--ease); }
  .short { font-size: 16px; }
  a :global(.go) { color: var(--link); transition: transform var(--fast) var(--ease); }
  a:hover .name { color: var(--link); }
  a:hover :global(.go) { transform: translateX(4px); }
  @media (max-width: 767px) { a { grid-template-columns: 1fr auto; } .short { grid-column: 1; grid-row: 2; } .go { grid-row: 1 / 3; grid-column: 2; } }
</style>
