---
import { people, initials } from '../../data/people';
---
<section class="section" data-reveal aria-labelledby="people-h">
  <div class="wrap">
    <h2 id="people-h">Leadership</h2>
    <ul class="grid" data-stagger>
      {people.map((p, i) => (
        <li style={`--i:${i}`}>
          <button type="button" class="person" data-open={p.slug} aria-haspopup="dialog">
            {p.photo
              ? <img src={p.photo} alt="" width="480" height="480" loading="lazy" />
              : <span class="mark" aria-hidden="true">{initials(p.name)}</span>}
            <span class="name">{p.name}</span>
            <span class="role">{p.role}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  {people.map((p) => (
    <dialog class="sheet" id={`person-${p.slug}`} aria-labelledby={`person-${p.slug}-n`}>
      <form method="dialog"><button class="close" aria-label="Close">Close</button></form>
      <div class="inner">
        {p.photo && <img src={p.photo} alt={p.name} width="480" height="480" loading="lazy" />}
        <div class="text">
          <h3 id={`person-${p.slug}-n`}>{p.name}</h3>
          <p class="role">{p.role}</p>
          <p class="bio">{p.bio}</p>
          {p.linkedin && <p class="li"><a href={p.linkedin} rel="noopener">LinkedIn</a></p>}
        </div>
      </div>
    </dialog>
  ))}
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => {
    b.addEventListener('click', () => {
      const d = document.getElementById(`person-${b.dataset.open}`) as HTMLDialogElement | null;
      d?.showModal();
    });
  });
  // A click on the backdrop closes the sheet.
  document.querySelectorAll<HTMLDialogElement>('dialog.sheet').forEach((d) => {
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-7) var(--space-5); }
  .person { display: grid; gap: var(--space-1); width: 100%; padding: 0; border: 0; background: none; text-align: left; cursor: pointer; color: var(--ink); }
  .person img, .mark { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: top; border-radius: var(--radius-panel); background: var(--surface); margin-bottom: var(--space-3); transition: opacity var(--fast) var(--ease); }
  .mark { display: grid; place-items: center; font-family: var(--font-display); font-weight: 600; font-size: 2.5rem; color: var(--ink-muted); }
  .person:hover img, .person:hover .mark { opacity: 0.88; }
  .name { font-family: var(--font-display); font-weight: 600; font-size: 1.125rem; }
  .role { font-size: 15px; color: var(--ink-muted); }
  .person:focus-visible { outline: 2px solid var(--link); outline-offset: 4px; border-radius: var(--radius-panel); }

  .sheet { width: min(720px, calc(100vw - 2 * var(--gutter))); max-height: calc(100dvh - 2 * var(--gutter)); padding: 0; border: 0; border-radius: var(--radius-panel); background: var(--canvas); color: var(--ink); overflow: auto; }
  .sheet::backdrop { background: rgba(11, 31, 77, 0.55); }
  .close { position: absolute; top: var(--space-3); right: var(--space-3); min-height: 44px; padding: 0 var(--space-4); border: 1px solid var(--line); border-radius: var(--radius-control); background: var(--canvas); cursor: pointer; font-weight: 500; }
  .inner { display: grid; grid-template-columns: 200px 1fr; gap: var(--space-6); padding: var(--space-7) var(--space-6) var(--space-6); }
  .inner:not(:has(img)) { grid-template-columns: 1fr; }
  .inner img { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: top; border-radius: var(--radius-panel); }
  h3 { font-size: 1.5rem; }
  .text .role { margin-top: var(--space-1); }
  .bio { margin-top: var(--space-4); }
  .li { margin-top: var(--space-4); }
  @media (max-width: 899px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 599px) { .inner { grid-template-columns: 1fr; padding-inline: var(--space-5); } .inner img { max-width: 220px; } }
</style>
