---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Products from '../components/home/Products.astro';
import Group from '../components/home/Group.astro';
import Latest from '../components/home/Latest.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { langOf, ui } from '../lib/i18n';
const T = ui[langOf(Astro.currentLocale)];
---
<Base description={T.homeDesc} path="/">
  <Hero />
  <Products />
  <Group />
  <Latest />
  <CtaBand />
</Base>
