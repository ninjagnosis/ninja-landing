---
import Base from '../layouts/Base.astro';
import Products from '../components/home/Products.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { NEPAL, NEPAL_ADDRESS, LLC_ADDRESS, SITE_NAME, CERTIFICATIONS } from '../config/site';
import { breadcrumbJsonLd } from '../lib/seo';

---
<Base
  title="About Ninja Infosys LLC: software, certification and offices"
  pageType="AboutPage"
  description="About Ninja Infosys LLC: the software it builds and runs, its ISO 9001:2015 certification, its offices in Denver and Kathmandu, and the awards it has received."
  path="/about"
  jsonLd={[breadcrumbJsonLd([{ name: 'About', path: '/about' }])]}
>
  <section class="section">
    <div class="wrap">
      <h1 data-enter>About {SITE_NAME}</h1>
      <p class="lead" data-enter style="--d:1">
        We design, build and operate software for organisations and the people who depend on them.
      </p>
    </div>
  </section>

  <Products heading="What we run" />

  <section class="section-tight" data-reveal>
    <div class="wrap">
      <p class="recog">Recognition and coverage, including the ASOCIO Digital Government Award 2025: <a href="/media">awards and press</a>.</p>
    </div>
  </section>

  <section class="section surface" data-reveal>
    <div class="wrap">
      <h2>Certification</h2>
      <ul class="certs">
        {CERTIFICATIONS.map((c) => (
          <li><p class="cert-name">{c.name}</p><p class="cert-note">{c.description}. {SITE_NAME} is certified to this international standard.</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap">
      <h2>Where we operate</h2>
      <div class="offices">
        <div>
          <h3>{SITE_NAME}</h3>
          <p>{LLC_ADDRESS}</p>
        </div>
        <div>
          <h3>{NEPAL.legalName}</h3>
          <p>Private limited company</p>
          <p>{NEPAL_ADDRESS}</p>
          {NEPAL.registrationNumber && <p>Company registration number: {NEPAL.registrationNumber}</p>}
          {NEPAL.panNumber && <p>PAN: {NEPAL.panNumber}</p>}
        </div>
      </div>
      <p class="more"><a href="/locations">Offices and contact details</a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .lead { margin-top: var(--space-5); max-width: 38em; font-size: 1.25rem; color: var(--ink-muted); }
  .offices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); }
  h3 { margin-bottom: var(--space-3); }
  .offices > div { border-top: 1px solid var(--line); padding-top: var(--space-5); }
  .offices p { color: var(--ink-muted); }
  .offices p + p { margin-top: var(--space-1); }
  .recog { max-width: 40em; }
  .surface { background: var(--surface); }
  .certs { list-style: none; margin: 0; padding: 0; max-width: 40em; }
  .certs li { padding: var(--space-4) 0; border-top: 1px solid var(--line); }
  .certs li:last-child { border-bottom: 1px solid var(--line); }
  .cert-name { font-family: var(--font-display); font-weight: 600; font-size: 1.375rem; }
  .cert-note { margin-top: var(--space-1); color: var(--ink-muted); }
  .more { margin-top: var(--space-7); font-weight: 500; }
  .section > .wrap > h2:first-child { margin-bottom: var(--space-6); }
  @media (max-width: 767px) { .offices { grid-template-columns: 1fr; gap: var(--space-7); } }
</style>
