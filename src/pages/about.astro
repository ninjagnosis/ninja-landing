---
import Base from '../layouts/Base.astro';
import Products from '../components/home/Products.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { NEPAL, NEPAL_ADDRESS, LLC_ADDRESS, SITE_NAME } from '../config/site';
import { breadcrumbJsonLd } from '../lib/seo';
---
<Base title="About" description="Ninja Infosys LLC is a holding company. It owns and runs eShasan, ePahichan, AirFone, LunaIoT and LunaCam and operates in Nepal through Ninja Infosys Pvt. Ltd." path="/about" jsonLd={[breadcrumbJsonLd([{ name: 'About', path: '/about' }])]}>
  <section class="section">
    <div class="wrap">
      <h1 data-enter>About {SITE_NAME}</h1>
      <div class="prose" data-enter style="--d:1">
        <p>{SITE_NAME} is a holding company. It owns and runs a group of software products and decides where the group invests, what it builds next and what it stops.</p>
        <p>The products are eShasan, ePahichan, AirFone, LunaIoT and LunaCam. Each one has its own site and its own users. The group sits above them and keeps the work that should be shared, such as finance, hiring and strategy, in one place.</p>
        <h2>Where we operate</h2>
        <p>{SITE_NAME} is based at {LLC_ADDRESS}. In Nepal the group operates through {NEPAL.legalName}, a Nepal-registered private limited company at {NEPAL_ADDRESS}.</p>
        {(NEPAL.registrationNumber || NEPAL.panNumber) && (
          <p>
            {NEPAL.registrationNumber && <>Company registration number: {NEPAL.registrationNumber}. </>}
            {NEPAL.panNumber && <>PAN: {NEPAL.panNumber}.</>}
          </p>
        )}
        <p><a href="/locations">Offices and contact details</a></p>
      </div>
    </div>
  </section>
  <Products heading="What the group holds" />
  <CtaBand />
</Base>
