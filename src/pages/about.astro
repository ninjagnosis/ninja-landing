---
import Base from '../layouts/Base.astro';
import Products from '../components/home/Products.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { NEPAL, NEPAL_ADDRESS, LLC_ADDRESS, SITE_NAME } from '../config/site';
import { breadcrumbJsonLd } from '../lib/seo';
import { href, langOf, ui } from '../lib/i18n';
const lang = langOf(Astro.currentLocale);
const T = ui[lang];
---
<Base title={T.about} description={T.aboutDesc} path="/about" jsonLd={[breadcrumbJsonLd([{ name: T.about, path: '/about' }])]}>
  <section class="section">
    <div class="wrap">
      <h1 data-enter>{T.aboutH}</h1>
      <div class="prose" data-enter style="--d:1">
        <p>{T.aboutP1}</p>
        <p>{T.aboutP2}</p>
        <h2>{T.where}</h2>
        {lang === 'ne'
          ? <p>{SITE_NAME} को ठेगाना {LLC_ADDRESS} हो। नेपालमा समूह {NEPAL.legalName} मार्फत सञ्चालन हुन्छ, जुन {NEPAL_ADDRESS} मा रहेको नेपालमा दर्ता भएको निजी लिमिटेड कम्पनी हो।</p>
          : <p>{SITE_NAME} is based at {LLC_ADDRESS}. In Nepal the group operates through {NEPAL.legalName}, a Nepal-registered private limited company at {NEPAL_ADDRESS}.</p>}
        {(NEPAL.registrationNumber || NEPAL.panNumber) && (
          <p>
            {NEPAL.registrationNumber && <>{T.regNo}: {NEPAL.registrationNumber}. </>}
            {NEPAL.panNumber && <>{T.pan}: {NEPAL.panNumber}.</>}
          </p>
        )}
        <p><a href={href(lang, '/locations')}>{T.officesLink}</a></p>
      </div>
    </div>
  </section>
  <Products heading={T.holds} />
  <CtaBand />
</Base>
