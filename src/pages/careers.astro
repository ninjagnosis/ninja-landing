---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../config/site';
import { breadcrumbJsonLd } from '../lib/seo';
import { langOf, ui } from '../lib/i18n';
const T = ui[langOf(Astro.currentLocale)];
---
<Base title={T.careers} description={T.careersDesc} path="/careers" jsonLd={[breadcrumbJsonLd([{ name: T.careers, path: '/careers' }])]}>
  <section class="section">
    <div class="wrap">
      <h1 data-enter>{T.careers}</h1>
      <div class="prose" data-enter style="--d:1">
        <p>{T.careersP1}</p>
        <p>{T.careersP2} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
      </div>
    </div>
  </section>
</Base>
