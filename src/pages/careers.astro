---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../config/site';
import { breadcrumbJsonLd } from '../lib/seo';
---
<Base
  title="Careers"
  description="Ninja Infosys LLC has no open roles right now. Roles are listed on this page when they open, and you can introduce yourself by email at any time."
  path="/careers"
  jsonLd={[breadcrumbJsonLd([{ name: 'Careers', path: '/careers' }])]}
>
  <section class="section">
    <div class="wrap">
      <h1 data-enter>Careers</h1>

      <div class="block" data-enter style="--d:1">
        <h2>Open roles</h2>
        <p class="none">None at the moment. When a role opens, it is listed here.</p>
      </div>

      <div class="block" data-enter style="--d:2">
        <h2>Introduce yourself</h2>
        <p>If you would like us to know you, send a short note about what you work on, with a CV or a link to your work.</p>
        <p class="mail"><a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}?subject=Introduction`}>{CONTACT_EMAIL}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { margin-bottom: var(--space-7); }
  .block { max-width: var(--measure); padding-block: var(--space-6); border-top: 1px solid var(--line); }
  .block:last-of-type { border-bottom: 1px solid var(--line); }
  h2 { font-size: 1.375rem; margin-bottom: var(--space-3); }
  .none { color: var(--ink-muted); }
  .mail { margin-top: var(--space-5); }
</style>
