---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist on the Ninja Infosys LLC site." path="/404" noindex>
  <section class="section">
    <div class="wrap">
      <h1>Page not found</h1>
      <p class="muted" style="margin-top: var(--space-4)">Go to the <a href="/">home page</a>, the <a href="/products">products</a> or the <a href="/blog">blog</a>.</p>
    </div>
  </section>
</Base>
