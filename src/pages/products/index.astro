---
import Base from '../../layouts/Base.astro';
import Products from '../../components/home/Products.astro';
import CtaBand from '@ninjainfosys/site-kit/components/site/CtaBand.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
---
<Base title="Software products by Ninja Infosys LLC" pageType="CollectionPage" description="eShasan for institutions, ePahichan for digital signatures, AirFone for business phones, LunaIoT for GPS tracking and LunaCam for cameras, from Ninja Infosys LLC." path="/products" jsonLd={[breadcrumbJsonLd([{ name: 'Products', path: '/products' }])]}>
  <h1 class="wrap page-h1">Products</h1>
  <Products heading="Our products" />
  <CtaBand />
</Base>

<style>
  .page-h1 { padding-top: var(--space-8); }
</style>
