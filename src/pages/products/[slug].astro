---
import ExternalLink from '@lucide/astro/icons/external-link';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import Related from '../../components/site/Related.astro';
import PostList from '../../components/blog/PostList.astro';
import { products, type Product } from '../../data/products';
import { posts } from '../../lib/posts';
import { breadcrumbJsonLd, productJsonLd } from '../../lib/seo';
import { href, langOf, ui } from '../../lib/i18n';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const lang = langOf(Astro.currentLocale);
const T = ui[lang];
const { product: p } = Astro.props as { product: Product };
const L = lang === 'ne' ? p.ne : p;
const path = `/products/${p.slug}`;
const about = lang === 'ne' ? [] : (await posts()).filter((x) => x.data.tags.some((t) => p.tags.includes(t))).slice(0, 3);
const others = products.filter((x) => x.slug !== p.slug).map((x) => ({ href: href(lang, `/products/${x.slug}`), label: x.name, meta: lang === 'ne' ? x.ne.short : x.short }));
---
<Base
  title={p.name}
  description={lang === 'ne' ? `${p.name}: ${L.short} Ninja Infosys LLC को उत्पादन।` : `${p.name}: ${p.short} A product of Ninja Infosys LLC.`}
  path={path}
  image={p.image}
  jsonLd={[productJsonLd(p), breadcrumbJsonLd([{ name: T.products, path: '/products' }, { name: p.name, path }])]}
>
  <section class="section">
    <div class="wrap grid">
      <div>
        <h1 data-enter>{L.headline}</h1>
        <p class="lead" data-enter style="--d:1">{L.description}</p>
        <div class="actions" data-enter style="--d:2">
          <a class="btn btn-primary" href={p.url} rel="noopener">{lang === 'ne' ? `${p.host} ${T.visit}` : `${T.visit} ${p.host}`} <ExternalLink size={18} aria-hidden="true" /></a>
        </div>
      </div>
      {p.image && <img class="visual" src={p.image} alt={p.imageAlt ?? p.name} width="1200" height="800" loading="eager" />}
    </div>
  </section>

  <section class="section-tight surface" data-reveal>
    <div class="wrap">
      <h2>{T.does}</h2>
      <ul class="points" data-stagger>
        {L.highlights.map((h, i) => <li style={`--i:${i}`}>{h}</li>)}
      </ul>
    </div>
  </section>

  {about.length > 0 && (
    <section class="section blog-serif">
      <div class="wrap">
        <h2>Posts about {p.name}</h2>
        <PostList items={about} level="h3" />
      </div>
    </section>
  )}

  <Related groups={[{ h: T.others, items: others }]} />
  <CtaBand />
</Base>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: center; }
  .lead { margin-top: var(--space-5); font-size: 1.25rem; color: var(--ink-muted); max-width: 40ch; }
  .actions { margin-top: var(--space-6); }
  .visual { width: 100%; border-radius: var(--radius-panel); border: 1px solid var(--line); object-fit: cover; }
  .surface { background: var(--surface); }
  .points { list-style: none; margin: var(--space-5) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-7); }
  .points li { padding-top: var(--space-4); border-top: 1px solid var(--line); }
  .section-tight > .wrap > h2 { margin-bottom: 0; }
  @media (max-width: 859px) { .grid { grid-template-columns: 1fr; } .points { grid-template-columns: 1fr; } }
</style>
